{
  "name": "@vitest-faster/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "description": "FASTER test prioritization and selection for upstream Vitest, as a plugin",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -C packages/vitest-faster run build",
    "dev": "pnpm -C packages/vitest-faster run dev",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "pnpm -C test/faster-compat run test",
    "test:demo": "pnpm -C examples/faster-demo run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "24.12.0",
    "eslint": "^10.0.3",
    "premove": "^4.0.0",
    "rollup": "^4.59.0",
    "typescript": "^5.9.3",
    "unplugin-oxc": "^0.6.0",
    "vite": "7.1.5",
    "vitest": "4.1.7"
  }
}
